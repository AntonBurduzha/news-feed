# Root .env — consumed by docker-compose.yml only.
# Copy to .env:  cp .env.example .env
#
# These credentials must match POSTGRES_DB_* / MONGO_DB_* in the service .env files.

POSTGRES_DB_USER=root_user
POSTGRES_DB_PASSWORD=root_secret_password
POSTGRES_DB_NAME=node_kafka_db

MONGO_DB_USER=root_user
MONGO_DB_PASSWORD=root_secret_password
MONGO_DB_NAME=node_kafka_mongo_db
