discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

discovery.relabel "news_feed" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "news-feed"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

// Read stdout/stderr of each container through the docker API
loki.source.docker "news_feed" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.news_feed.output
  forward_to = [loki.process.news_feed.receiver]
}

// Parse the JSON line; level/service become labels for low cardinality.
loki.process "news_feed" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      level   = "level",
      service = "service",
    }
  }

  stage.labels {
    values = {
      level   = "",
      service = "",
    }
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}


prometheus.scrape "news_feed_services" {
  targets = [
    { "__address__" = "monolith:3000",         "service" = "news-feed-monolith" },
    { "__address__" = "comments-service:3001", "service" = "comments-svc"       },
    { "__address__" = "auth-service:3002",     "service" = "auth-svc"           },
    { "__address__" = "fan-out-service:3004",  "service" = "fan-out-service"    },
    { "__address__" = "outbox-relay:3010",     "service" = "outbox-relay"       },
  ]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

prometheus.scrape "postgres" {
  targets = [
    { "__address__" = "postgres-exporter:9187", "service" = "postgres" },
  ]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

prometheus.scrape "mongodb" {
  targets = [
    { "__address__" = "mongodb-exporter:9216", "service" = "mongodb" },
  ]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

prometheus.scrape "kafka" {
  targets = [
    { "__address__" = "kafka-exporter:9308", "service" = "kafka" },
  ]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
  }
}


otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
