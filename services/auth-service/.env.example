# services/auth-service/.env — copy to .env:  cp .env.example .env
# Schema of record: src/config/env.ts

PORT=3002
NODE_ENV=development
SERVICE_NAME=auth-svc
LOG_LEVEL=info
LOG_HTTP_INFRA=false

# Shares the monolith's Postgres database (users, refresh_tokens)
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_USER=root_user
POSTGRES_DB_PASSWORD=root_secret_password
POSTGRES_DB_NAME=node_kafka_db

REDIS_URL=redis://localhost:6379

# Signed into every access token; consumers verify against these
JWT_ISSUER=auth-svc
JWT_AUDIENCE=news-feed

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=auth-svc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
