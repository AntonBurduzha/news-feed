# services/fan-out-service/.env — copy to .env:  cp .env.example .env
# Schema of record: src/config/env.ts

SERVICE_NAME=fan-out-service
PORT=3004
NODE_ENV=development
LOG_LEVEL=info
LOG_HTTP_INFRA=false

REDIS_URL=redis://localhost:6379

AUTH_JWKS_URL=http://localhost:3002/.well-known/jwks.json
AUTH_ISSUER=auth-svc
AUTH_AUDIENCE=news-feed

# Source of truth for follows/posts/users — read over /internal/*
MONOLITH_URL=http://localhost:3000
# Must match INTERNAL_API_KEY in the monolith
INTERNAL_API_KEY=dev-internal-secret-change-me

KAFKA_NEWS_FEED_SERVICE_CLIENT_ID=news-feed-service
# The broker advertises itself as kafka:9092 — add "127.0.0.1 kafka" to /etc/hosts
KAFKA_BROKERS=127.0.0.1:9092

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=fan-out-service
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
