# services/comments-service/.env — copy to .env:  cp .env.example .env
# Schema of record: src/config/env.ts

PORT=3001
NODE_ENV=development
SERVICE_NAME=comments-svc
LOG_LEVEL=info
LOG_HTTP_INFRA=false

MONGO_DB_HOST=localhost
MONGO_DB_PORT=27017
MONGO_DB_USER=root_user
MONGO_DB_PASSWORD=root_secret_password
MONGO_DB_NAME=node_kafka_mongo_db

REDIS_URL=redis://localhost:6379

AUTH_JWKS_URL=http://localhost:3002/.well-known/jwks.json
AUTH_ISSUER=auth-svc
AUTH_AUDIENCE=news-feed

KAFKA_NEWS_FEED_SERVICE_CLIENT_ID=news-feed-service
# The broker advertises itself as kafka:9092 — add "127.0.0.1 kafka" to /etc/hosts
KAFKA_BROKERS=127.0.0.1:9092

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=comments-svc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
