# services/monolith/.env — copy to .env:  cp .env.example .env
# Schema of record: src/config/env.ts

PORT=3000
OUTBOX_RELAY_PORT=3010
DLQ_REDRIVE_PORT=3011
NODE_ENV=development
SERVICE_NAME=news-feed-monolith
OUTBOX_RELAY_SERVICE_NAME=outbox-relay
DLQ_REDRIVE_SERVICE_NAME=dlq-redrive
LOG_LEVEL=info
# LOG_HTTP_INFRA=true also logs /healthz, /readyz and /metrics requests
LOG_HTTP_INFRA=false

# Upstream for the /comments proxy
COMMENTS_SVC_URL=http://localhost:3001

POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_USER=root_user
POSTGRES_DB_PASSWORD=root_secret_password
POSTGRES_DB_NAME=node_kafka_db
# Read directly by node-pg-migrate (not by src/config/env.ts)
DATABASE_URL=postgresql://root_user:root_secret_password@localhost:5432/node_kafka_db

REDIS_URL=redis://localhost:6379

AUTH_JWKS_URL=http://localhost:3002/.well-known/jwks.json
AUTH_ISSUER=auth-svc
AUTH_AUDIENCE=news-feed

# Shared secret for /internal/* routes — must match INTERNAL_API_KEY in fan-out-service
INTERNAL_API_KEY=dev-internal-secret-change-me

KAFKA_NEWS_FEED_SERVICE_CLIENT_ID=news-feed-service
# The broker advertises itself as kafka:9092 — add "127.0.0.1 kafka" to /etc/hosts
KAFKA_BROKERS=kafka:9092

# Only needed for PUT /users/:id/avatar — leave blank to run everything else
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_BUCKET_NAME=s3-news-feed-upload

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=news-feed-monolith
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
